{
  "schema_version": 1,
  "id": "sshOS",
  "version": "v1",
  "goal": "sshOS 1.0.0을 공통 OS형 작업 공간, 실제 SSH 인증, 비동기 SFTP, 시스템·서비스·프로세스·로그 앱과 30개 수용 기준으로 구현한다.",
  "excluded": [
    "브라우저 호스팅",
    "모바일·Linux 클라이언트",
    "Ubuntu 24.04 외 서버",
    "SSH agent·ProxyJump",
    "대화형 터미널",
    "Docker·Kubernetes 전용 관리",
    "패키지·사용자·방화벽 관리",
    "서버 종료·재부팅",
    "파일 편집·chmod·chown UI",
    "서버 간 직접 전송",
    "이어받기",
    "플러그인·AI 실행",
    "팀·클라우드 동기화",
    "다국어 선택·자동 업데이트"
  ],
  "assumptions": [
    "D01–D13은 작성자가 제안한 고정 설계값이며 사용자의 v1 승인 후 구현 기준이 된다.",
    "이번 작업은 계획서와 이미지 산출물 작성이다. 제품 구현은 후속 개발 착수 요청으로 시작한다.",
    "공개 GitHub origin은 지정되지 않았으며 로컬 bare origin을 계획한다."
  ],
  "open_questions": [],
  "approval": {
    "status": "pending",
    "spec_version": "v1",
    "evidence": "",
    "spec_sha256": ""
  },
  "requirements": [
    {
      "id": "R01",
      "priority": "must",
      "statement": "제품 작업 공간",
      "acceptance": "홈·앱 실행 막대·상단 열린 창·하단 전송 영역이 단일 앱에서 동작한다.",
      "checks": [
        "C01"
      ]
    },
    {
      "id": "R02",
      "priority": "must",
      "statement": "창 수명과 서버 귀속",
      "acceptance": "최대 12개 창, 서버별 앱 창, 이동·최소화·최대화·복원, 재실행 시 연결 대기를 확인한다.",
      "checks": [
        "C02"
      ]
    },
    {
      "id": "R03",
      "priority": "must",
      "statement": "지원 환경",
      "acceptance": "정의된 클라이언트 3종과 서버 2개 아키텍처에서 필수 시나리오가 통과한다.",
      "checks": [
        "C03"
      ]
    },
    {
      "id": "R04",
      "priority": "must",
      "statement": "연결 프로필",
      "acceptance": "입력 경계·수정·삭제·동시 10대 제한·프로필 보존이 명세와 일치한다.",
      "checks": [
        "C04"
      ]
    },
    {
      "id": "R05",
      "priority": "must",
      "statement": "인증",
      "acceptance": "비밀번호와 정의된 암호화·비암호화 키 형식의 성공·실패가 구분된다.",
      "checks": [
        "C05"
      ]
    },
    {
      "id": "R06",
      "priority": "must",
      "statement": "호스트 신뢰",
      "acceptance": "최초 확인, 기존 일치, 변경 차단, 명시적 교체, 전송 연결 검증이 통과한다.",
      "checks": [
        "C06"
      ]
    },
    {
      "id": "R07",
      "priority": "must",
      "statement": "연결 수명",
      "acceptance": "시간 제한·취소·끊김·작업 종료 확인이 상태표와 일치한다.",
      "checks": [
        "C07"
      ]
    },
    {
      "id": "R08",
      "priority": "must",
      "statement": "자격 증명",
      "acceptance": "저장 선택·재실행 복호화·삭제·암호화 사용 불가 오류를 확인한다.",
      "checks": [
        "C08"
      ]
    },
    {
      "id": "R09",
      "priority": "must",
      "statement": "파일 탐색",
      "acceptance": "트리·목록 경로 동기화, 이력, 숨김, 정렬, 검색이 정의대로 동작한다.",
      "checks": [
        "C09"
      ]
    },
    {
      "id": "R10",
      "priority": "must",
      "statement": "파일 변경",
      "acceptance": "생성·이름 변경·삭제·권한 오류·링크 처리가 실제 서버 결과와 일치한다.",
      "checks": [
        "C10"
      ]
    },
    {
      "id": "R11",
      "priority": "must",
      "statement": "파일 표현",
      "acceptance": "상세 정보, UTF-8 1 MiB 제한, Windows 이름 충돌, 특수파일 처리가 통과한다.",
      "checks": [
        "C11"
      ]
    },
    {
      "id": "R12",
      "priority": "must",
      "statement": "전송 기본",
      "acceptance": "파일·폴더의 양방향 전송, 다중 선택, 드롭, 0 byte·대용량 파일의 내용이 일치한다.",
      "checks": [
        "C12"
      ]
    },
    {
      "id": "R13",
      "priority": "must",
      "statement": "비동기와 진행",
      "acceptance": "UI 동시 조작, 250 ms 갱신, finalizing 99%, 완료 100%, 하단 상시 표시를 확인한다.",
      "checks": [
        "C13"
      ]
    },
    {
      "id": "R14",
      "priority": "must",
      "statement": "전송 스케줄",
      "acceptance": "전체 3개·서버별 2개, 같은 목적지 직렬 실행, 대기 순서가 일치한다.",
      "checks": [
        "C14"
      ]
    },
    {
      "id": "R15",
      "priority": "must",
      "statement": "충돌과 확정",
      "acceptance": "덮어쓰기 전 원본 유지, 다른 이름·건너뛰기, 임시 파일·확정 실패 처리가 통과한다.",
      "checks": [
        "C15"
      ]
    },
    {
      "id": "R16",
      "priority": "must",
      "statement": "취소와 재시도",
