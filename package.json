{
  "name": "sshos",
  "productName": "sshOS",
  "version": "0.1.0",
  "private": true,
  "description": "sshOS(시오스): client-only SSH desktop workspace",
  "license": "AGPL-3.0-only",
  "author": "JunSungKang",
  "main": "dist/main/index.js",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node scripts/launch.mjs",
    "test:unit": "vitest run",
    "test:e2e": "node scripts/electron-smoke.mjs",
    "test:integration": "node scripts/verify.mjs integration",
    "test:security": "vitest run tests/unit/security.test.ts tests/unit/diagnostic-log.test.ts tests/unit/ssh-authentication.test.ts tests/unit/ssh-handshake.test.ts tests/unit/key-parser.test.ts tests/unit/terminal-boundaries.test.ts tests/unit/terminal-gestures.test.ts tests/unit/transfer-scope.test.ts && node scripts/verify.mjs security",
    "test:performance": "node scripts/performance.mjs",
    "package:win": "node scripts/package.mjs win",
    "package:mac": "node scripts/package.mjs mac",
    "pretest:unit": "tsc -p tsconfig.json",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "tsc -p tsconfig.json",
    "pretest:integration": "npm run build",
    "pretest:security": "npm run build",
    "pretest:e2e": "npm run build",
    "prebuild": "node scripts/prepare-licenses.mjs",
    "pretest:performance": "npm run build"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ssh2": "1.15.6",
    "@vitest/coverage-v8": "5.1.0",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch@^9.0.3": "11.0.9",
    "minimatch@^10.2.5": "11.0.9"
  }
}
